<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS URL Rewrite 配置(等价于 .htaccess):
  真实存在的文件/目录直接放行, 其余全部路由到 index.php 前置控制器
  注意: matchType 的 IsFile / IsDirectory 首字母必须大写, 小写在部分 IIS 版本下无法保存/生效
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="DenyData" stopProcessing="true">
          <match url="^(data|tools)(/|$)" ignoreCase="false" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^.*" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" pattern="" ignoreCase="false" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="StaticDirectories" stopProcessing="true">
          <match url="^.*" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" pattern="" ignoreCase="false" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="FrontController" stopProcessing="true">
          <match url="^.*" ignoreCase="false" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
    <!-- 不在子级配置 defaultDocument: IIS 服务器级默认文档通常已含 index.php,
         子级重复 <add value="index.php"> 会触发 500.19 "重复集合项"(0x800700b7) -->
  </system.webServer>
</configuration>
