<?xml version="1.0" encoding="UTF-8"?>
<!--
  坤发卡 - data目录访问保护(等价于 data/.htaccess 的 Deny from all)
  本目录存放 config.php(数据库凭据)与 install.lock, 任何HTTP请求一律返回403
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="deny_data_dir" stopProcessing="true">
          <match url=".*" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" subStatusCode="0" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
